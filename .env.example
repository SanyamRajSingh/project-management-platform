# ==============================================================================
# FLOWTIDE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in backend/ or root for local development.
# Replace placeholder values with your specific development or production secrets.
# NEVER commit .env or files with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 16+)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=flowtide
# Cloud PostgreSQL (Neon / Supabase / AWS RDS):
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# Cache & Message Broker (Redis 7+)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# Authentication & Security
# IMPORTANT: Generate a cryptographically secure random string (minimum 32 chars)
JWT_SECRET=replace-with-a-secure-random-32-character-secret-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Transactional Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flowtide <noreply@flowtide.app>

# Stripe Billing (Optional for basic internship evaluation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Mobile Configuration (Expo / React Native)
# ------------------------------------------------------------------------------
# Set EXPO_PUBLIC_API_BASE_URL to your development machine's LAN IP when testing
# on a physical Android device or emulator (e.g., http://192.168.1.10:3000/api)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
